# LK_Forward on Tradovate. Copy this file to lk.env (same folder) and fill it in.
# lk.env holds your password: it is ignored by git and must never be uploaded.

# --- Tradovate login --------------------------------------------------------
LK_ENV=demo                 # demo first. live = real Tradovate server (FundedNext accounts may live there)
LK_USER=
LK_PASSWORD=
LK_CID=                     # API key id from Tradovate (ask FundedNext whether their accounts allow API keys)
LK_SEC=                     # API key secret
LK_APP_ID=orb-bot
LK_APP_VERSION=1.0
LK_DEVICE_ID=orb-bot-mac
LK_ACCOUNT=                 # account name, if your login has more than one
# LK_MD_URL=                # only if Tradovate support gives you a different market-data address

# --- Contract ---------------------------------------------------------------
LK_SYMBOL=MNQZ6             # Micro Nasdaq, December 2026. Roll to MNQH7 around 10 Dec 2026.
LK_POINT_VALUE=2            # MNQ $2 per point (NQ: 20)
LK_TICK_SIZE=0.25

# --- Size and the prop-firm guard -------------------------------------------
LK_RISK_DOLLARS=100         # risk per trade: 12.5-point stop x $2 = $25 a contract -> 4 MNQ
LK_MAX_CONTRACTS=10         # FundedNext Rapid 25K: 10 micros. Check your account's limit.
LK_COMMISSION_RT=1.00       # commission per contract, round trip (check your statement)
LK_START_BALANCE=25000
LK_MLL=1000                 # Maximum Loss Limit (Rapid/Legacy 25K: $1,000)
LK_PAYOUT_TAKEN=0           # set 1 after your first payout (the floor resets to the start balance)
LK_FLOOR_OVERRIDE=0         # >0: use this floor instead (copy it from the FundedNext dashboard)
LK_BUFFER=50                # keep this much extra room above the floor for slippage

# --- Rules (signal window and flat time, New York time) ---------------------
LK_SIG_FROM=08:00
LK_SIG_TO=14:00
LK_FLAT=14:30
LK_NO_TRADE_DATES=          # e.g. 2026-11-04,2026-11-11 (days you will request a payout)

# --- Safety -----------------------------------------------------------------
LK_DRY_RUN=1                # 1 = signals and paper trades only, no orders. 0 = send orders.
LK_ALLOW_LIVE_ENV=0         # must be 1 to send orders when LK_ENV=live
